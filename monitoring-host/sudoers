clusterai ALL=(root) NOPASSWD: /usr/local/sbin/clustercloud-monitoring-helper status, /usr/local/sbin/clustercloud-monitoring-helper logs, /usr/local/sbin/clustercloud-monitoring-helper probe, /usr/local/sbin/clustercloud-monitoring-helper install, /usr/local/sbin/clustercloud-monitoring-helper start, /usr/local/sbin/clustercloud-monitoring-helper restart
